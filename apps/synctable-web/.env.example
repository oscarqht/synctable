# Raindrop.io OAuth 2.0 Credentials
# Obtain these from https://app.raindrop.io/settings/integrations
RAINDROP_CLIENT_ID=your_client_id_here
RAINDROP_CLIENT_SECRET=your_client_secret_here

# The redirect URI registered in your Raindrop application settings
# (Aliases supported: RAINDROP_CALLBACK_URL, NEXT_PUBLIC_RAINDROP_CALLBACK_URL)
RAINDROP_REDIRECT_URI=http://localhost:3000/api/auth/callback/raindrop
